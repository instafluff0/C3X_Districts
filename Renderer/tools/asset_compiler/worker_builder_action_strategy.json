  "special_actions": {
    "CAPTURE": {
      "selection": "stable_body_variation_modulo_4",
      "actions": ["captured_1", "captured_2", "captured_3", "captured_4"],
      "playback": "clamp"
    },
    "BUILD": {
      "action": "work_ground",
      "playback": "clamp",
      "meaning": "generic one-shot transition only; persistent worker jobs use job_id"
    },
    "REPAIR": {
      "selection": "stable_body_variation_modulo_4",
      "actions": ["work_repair_1", "work_repair_2", "work_repair_3", "work_repair_4"],
      "playback": "clamp",
      "meaning": "optional pack-authored action; ordinary Civ III workers have no distinct repair job"
    }
  },
  "attachment_selection": {
    "mode": "exclusive_attachment_group",
    "socket": "Tool",
    "group": "worker_tool",
    "select_exactly_one_for_work_action": true,
    "hide_for_non_work_action": true,
    "source_candidates": ["Tools/Axe", "Tools/Pickaxe", "Tools/Shovel", "Tools/Sledgehammer"],
    "source_tool_assets": {
      "Tools/Axe": "Builder_Axe",
      "Tools/Pickaxe": "Builder_PickAxe",
      "Tools/Shovel": "Builder_Shovel",
      "Tools/Sledgehammer": "Builder_SledgeHammer"
    },
    "runtime_candidates": [
      "unit/worker/tool/axe",
      "unit/worker/tool/pickaxe",
      "unit/worker/tool/shovel",
      "unit/worker/tool/hammer"
    ],
    "rule": "pack metadata selects an attachment by logical action; runtime code must not branch on Builder or source asset names"
  },
  "timing": {
    "authority": "civ3_worker_job_and_native_animation_progress",
    "loop": "repeat_pose_only_while_authoritative_job_remains_active",
    "default_slot_jobs": "use_a_stable_job_event_clock_without_changing_gameplay_duration",
    "completion": "tile_change_and_unit_transition_are_owned_by_civ3"
  },
  "effects": {
    "unit_clip_owns": ["body_pose", "tool_pose"],
    "effect_pipeline_owns": ["soil", "chips", "leaves", "sparks", "cleanup_particles"],
    "markers": "authored_normalized_phase_metadata_only",
    "audio": "retain_native_civ3_worker_audio"
  },
  "runtime_integration": "not_enabled"
}
