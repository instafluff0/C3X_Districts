{
  "schema": "c3x.resource_composition_profiles.v0",
  "purpose": "Offline art direction for baked resource tile compositions. The runtime consumes only the baked layouts; every size, count, sink and decal choice lives here or in the normalized source placements.",
  "units": "Normalized source units are 12 Civ VI units; world_scale 0.12 would match Civ VI's own size (100 Civ VI units per tile, the unit-model calibration); 0.24 doubles every outcrop for Civ III's far camera, where Civ VI's flat rocks would read as pebbles. Model burial is Civ VI's authored vertical origin (ResourceCompositionSources keeps it); sink is extra burial as a fraction of model height. Decal sizes are calibrated separately: decal_world_scale is the half-size in tiles per unit of source decal scale. Layout positions are tile UV (0..1). Animal subject_scale multiplies the animation pack's binding scale; at 0.5 a Civ VI horse is about a sixth of a tile long.",
  "defaults": {
    "variants": 4,
    "world_scale": 0.24,
    "count_scale": 0.55,
    "sink": 0.0,
    "clusters": 2,
    "cluster_radius": 0.75,
    "cluster_separation": 0.24,
    "spacing": 0.8,
    "decal_opacity": 1.0,
    "decal_world_scale": 0.16,
    "decal_lift": 0.01,
    "ground_fit": 0.6,
    "terrain_layouts": {
      "flat": {
        "terrains": [
          "Desert",
          "Plains",
          "Grassland",
          "Tundra",
          "Flood Plain",
          "Forest",
          "Jungle",
          "Marsh"
        ],
        "centre": [
          0.5,
          0.5
        ],
        "spread": 0.04,
        "keep_inside": 0.3,
        "arrangement": "random"
      },
      "hills": {
        "terrains": [
          "Hills"
        ],
        "centre": [
          0.55,
          0.55
        ],
        "spread": 0.02,
        "keep_inside": 0.28,
        "arrangement": "flank",
        "cluster_separation": 0.2,
        "sink": 0.05,
        "decal_scale": 0.7,
        "note": "Centred on the hill, a touch toward the camera; the two clusters sit side by side across the view so neither hides the other."
      },
      "mountains": {
        "terrains": [
          "Mountains",
          "Volcano"
        ],
        "centre": [
          0.8,
          0.8
        ],
        "spread": 0.01,
        "keep_inside": 0.05,
        "arrangement": "flank",
        "clusters": 3,
        "cluster_separation": 0.14,
        "arc": 0.0,
        "cluster_weights": [
          0.3,
          0.4,
          0.3
        ],
        "cluster_scales": [
          0.8,
          1.0,
          0.8
        ],
        "sink": 0.0,
        "ground_fit": 0.0,
        "decal_scale": 0.7,
        "scale": 0.9,
        "note": "Civ VI has no mountain resources. Three clusters, each on its own decal, spread side by side a little way up the mountain's lower front slope, just above the foot; the middle one is largest and carries the centre pile. The spread stays modest so the outer clusters stay in front of steeper mountains' flanks, and decals stay small because a round decal's upper half stretches tall on a steep face. Rocks rest on their centre height (a footprint minimum would bury them on the steep face)."
      }
    },
    "accent_scale": 0.6,
    "cluster_weights": null,
    "cluster_scales": null,
    "planting": "scatter"
  },
  "families": {
    "mineral_outcrop": {
      "description": "Civ VI rocks at their authored burial around Civ VI ground decals, as in the source diamond/iron/gold sets.",
      "ancillary_policy": "omit; forest/jungle crowding is a separate later pass"
    },
    "plant_patch": {
      "description": "Civ VI crop and plantation plants (alpha-masked cards cut out by their source opacity) with the boulders and shrubs Civ VI composes with them.",
      "world_scale": 0.22,
      "count_scale": 0.35,
      "accent_scale": 0.0,
      "ancillary_policy": "omit; forest/jungle crowding is a separate later pass"
    },
    "animal_herd": {
      "description": "A small herd of the resource's animated Civ VI subject (skinned, ambient clip) sized to a Civ III tile (each animal roughly a sixth of a tile long), standing on the terrain and tilted to its slope, with the boulders and grass Civ VI sets around it.",
      "world_scale": 0.22,
      "count_scale": 0.25,
      "accent_scale": 0.0,
      "herd": 2,
      "subject_scale": 0.3,
      "subject_radius": 0.08,
      "herd_spread": 1.3,
      "yaw_jitter": 0.5,
      "subject_fit": 0.6,
      "ancillary_policy": "omit; forest/jungle crowding is a separate later pass",
      "note": "subject_fit > 0 makes the posed body follow the ground plane under its footprint (a vertical shear: the body stays upright, heights follow the slope); 0 stands it at its centre height only."
    }
  },
