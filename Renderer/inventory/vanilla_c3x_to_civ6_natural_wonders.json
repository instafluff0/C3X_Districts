    "name": "Default C3X natural-wonder definitions",
    "definition_count": 18,
    "maximum_runtime_definitions": 64,
    "evidence": "default.districts_natural_wonders_config.txt",
    "runtime_note": "Scenario or user configs replace this entire default roster; this file is only an editable seed map."
  },
  "target_namespace": "Civ VI Features ArtDef m_Name identifiers, from the base game or a named Steam Workshop item",
  "policy": {
    "purpose": "Editable source-conversion choices for replacing the map body of a C3X natural-wonder instance",
    "selection_order": [
      "same named natural wonder (base game or Workshop)",
      "same real-world formation",
      "same silhouette, terrain setting, and water behavior",
      "authored C3X natural-wonder kit",
      "complete native C3X natural-wonder fallback"
    ],
    "runtime_identity": "Match the authoritative C3X natural_wonder_id and effective config definition; never infer gameplay identity from Civ VI art.",
    "replacement_ownership": "natural-wonder map body and explicitly compiled body-owned ambient attachments only",
    "retained_ownership": "Civ III fog and shroud, borders, grid, selection, cursor, minimap, HUD, UI, yields, passability, and all gameplay state",
    "label": "The C3X name label is renderer-drawn map text: C3X reports wonder id, tile and name and skips its native draw; the renderer draws it in Civ III's font look at screen resolution, anchored to the tile, under the fog and unexplored overlay.",
    "footprint": "All source pieces are rooted at one authoritative C3X tile. Source multi-tile layouts may overhang visually but never create gameplay tiles.",
    "fallback": "Replacement is atomic. Any incomplete or unavailable kit restores the complete native C3X sprite and configured animation exactly once.",
    "curation": "Every target, transform, part list, and approximation is replaceable by scenario or user renderer definitions without runtime Civ VI branching.",
    "source_kinds": "base = installed Civ VI and DLC; workshop = a named Steam Workshop item (Civ VI app 289070) the author has installed; authored = a Lab-composed kit, optionally from named source parts. Every kind is conversion input only and compiles into a generic C3X kit.",
    "seasons": "Each kit renders in all four C3X seasons through the shared production season code; season_parts lists the kit-owned extras a season needs (baked crown recolours, snowy pines, snow-free ground)."
  },
  "lab_approval": {
    "study": "Renderer/lab/studies/natural_wonders/kits.py",
    "approved": "2026-10-23",
    "scope": "Approved Lab look for all 18 default definitions, in summer, autumn, winter and spring. Not yet integrated."
  },
